! 光学的に厚いセルを進む電離波面 (R 型) のテスト: 一様 nH=0.1 cm^-3、64^3 (dx=15.6 pc、セルの tau~14、RT 1 step の tau~4)、
! 0.4 Myr (再結合時間 1.2 Myr より短い) まで。stromgren_amr.nml から作った (2026-11-15、docs/merge_ks.md「吸収の順序と収束判定」)。
! 光子の吸収方式 (attn_after_chem / attn_new_abund / rt_skip_convergence) と rt_courant_factor を変えて、
! tests/photon_budget.py 6 6 output_0000N で電離原子数と飛行中の光子数を比べる。Stromgren 球の平衡半径と違い方式の差が見える。
! ビルド: RT=1、DICE 空 (NIONS=4 のままでよい; xHII は変数 6)。4 ランクで約 2 分。
&RUN_PARAMS 
hydro=.true.
rt=.true.
nrestart=0
nremap=0
nstepmax=100000
ncontrol=1
nsubcycle=1,1,2,2,2,2,2
verbose=.false.
/

&INIT_PARAMS
nregion=1
region_type(1)='square'
x_center=0.5
y_center=0.5
z_center=0.5
length_x=100.0
length_y=100.0
length_z=100.0
exp_region=10.0
d_region=1d-1
p_region=8.69869d-8
var_region(1,1)=1e-6
/

&AMR_PARAMS 
levelmin=6
levelmax=6
ngridmax=300000
nexpand=1
boxlen=1.0
/

&OUTPUT_PARAMS
noutput=4
tout=0.05,0.1,0.2,0.4
foutput=100000
/

&HYDRO_PARAMS
gamma=1.4
courant_factor=0.8
scheme='muscl'
slope_type=2
riemann='hllc'
/

&COOLING_PARAMS
cooling=.true.
/

&UNITS_PARAMS
units_density=1.66d-24
units_time=3.1556926d13
units_length=3.08568025d21
/

&REFINE_PARAMS
err_grad_d=0.4
/

&RT_PARAMS
X=1d0
Y=0d0
rt_flux_scheme='glf'
rt_courant_factor=0.8
rt_c_fraction=0.01
rt_err_grad_n=0.3
rt_nsource=3
rt_source_type=3*'point'
rt_src_x_center=3*0.
rt_src_y_center=3*0.
rt_src_z_center=3*0.
rt_src_length_x=3*0.05
rt_src_length_y=3*0.05
rt_src_length_z=3*0.05
rt_src_group=1,2,3
rt_n_source=2.235d48,2.47d48,0.295d48 ! Total = 5d48
rt_u_source=3*0
rt_v_source=3*0
rt_w_source=3*0
rt_is_init_xion=.false.
attn_after_chem=.true.         ! + attn_new_abund=.true. (ks の順序) / rt_skip_convergence=.true. (判定なし) を足して比べる

/

&RT_GROUPS			! Blackbody at T=1d5 Kelvin
group_csn(1,:)= 3.00d-18, 0.,0.   ! pck 1-> HI, HeI, HeII
group_cse(1,:)= 2.78d-18, 0.,0.   ! pck 1-> HI, HeI, HeII
group_csn(2,:)= 5.69d-19, 0.,0.   ! pck 2-> HI, HeI, HeII
group_cse(2,:)= 5.04d-19, 0.,0.   ! pck 2-> HI, HeI, HeII
group_csn(3,:)= 7.89d-20, 0.,0.   ! pck 3-> HI, HeI, HeII
group_cse(3,:)= 7.46d-20, 0.,0.   ! pck 3-> HI, HeI, HeII
group_egy = 18.85, 35.079, 65.666
spec2group    = 1,2,3             ! HI, HeI, HeII -> pck
/

&BOUNDARY_PARAMS 
nboundary=6
bound_type= 1, 2,  1,  2,  1,  2
ibound_min=-1, 1, -1, -1, -1, -1
ibound_max=-1, 1,  1,  1,  1,  1
jbound_min= 0, 0, -1,  1, -1, -1
jbound_max= 0, 0, -1,  1,  1,  1
kbound_min= 0, 0,  0,  0, -1,  1
kbound_max= 0, 0,  0,  0, -1,  1
/
