! 5e10 Msun (z=12) を 1e12 Msun (z=6) に埋め込んだ MUSIC 初期条件 (5sigmaM5e10 の後継)。箱 12.8556 Mpc/h、初期条件 level 8-13
! ks の Pop II 比較ラン C_eps1 (4sigmaM10/pop2_compare/C_eps1/C_eps1.sh = 本番 ngridmax_intel.sh + 局所 Pop II の 5 項目) に
! 物理をそろえた patch/takashi 用の namelist (2026-11-27)。元は namelist/ks/ngridmax_music.nml。
! ビルド: bin/Makefile.xd_ks_intel (oneAPI, OPENMP=1; bin_ks/ で組む)。job script: jobfiles/xd/ks/music_M5e10_in_M1e12.sh
! (16 ノード、256 ランク x 7 スレッド; ngridmax は flat (1792 ランク、ngridmax=450000、npartmax=2000000) の 7 倍 = 総量は同じ、npartmax は境界粒子に合わせて 3.2e7)。
! `!KS` の行は ks の値のままだが patch/takashi に無い項目。`!TO` は takashi 側で意味や名前が違う項目の注記。
! job script が sed で埋める: nrestart。初期条件・SED・cloudy は job script が張る symlink (ICS, SED, cloudy/) を相対パスで読む。
&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.true.
rt=.true.
sink=.true.                    ! bhpop3: Pop III 残骸から BH sink (sf_fg なので sink_particle_fg.f90)
nrestart=0
nremap=1
nsubcycle=6*1,21*2
ncontrol=1
verbose=.false.
cost_weighting=.true.
two_tier_balance=.true.        ! 2 層 domain decomposition
two_tier_level=-1              ! Ls は balance のたびに全候補を採点して選ぶ (ks 本番は固定 13)
omp_cg=.true.                  ! CG の反復もスレッド化 (7 スレッドの DICE 本番と同じ)
!KS clumpfind=.false.
!KS fof_find=.false.           ! fof.f90 / fof_commons.f90
/
!KS &FOF_PARAMS
!KS fof_level=8
!KS npmin=20
!KS f_fof=0.25
!KS /
&POISSON_PARAMS
cic_levelmax=100
cg_auto=.true.                 ! level ごとに multigrid / CG を実測で選ぶ (cg_auto_every coarse step ごと)
cg_auto_every=20
cg_warm_start=.false.          ! warm start は zoom の高赤方偏移ランでは逆効果なので使わない
/
&OUTPUT_PARAMS
aend=0.167
aout=0.009871,0.011733,0.013457,0.015077,0.016614,0.018083,0.019494,0.020856,0.022175,0.023456,
     0.024703,0.025919,0.027107,0.028269,0.029409,0.030526,0.031624,0.032702,0.033764,0.034808,
     0.035838,0.036853,0.037854,0.038841,0.039817,0.040781,0.041733,0.042675,0.043606,0.044528,
     0.045440,0.046343,0.047238,0.048124,0.049002,0.049872,0.050735,0.051590,0.052438,0.053280,
     0.054115,0.054944,0.055766,0.056582,0.057393,0.058198,0.058997,0.059791,0.060580,0.061363,
     0.062142,0.062916,0.063685,0.064450,0.065210,0.065965,0.066716,0.067464,0.068207,0.068946,
     0.069681,0.070412,0.071139,0.071863,0.072583,0.073300,0.074013,0.074723,0.075429,0.076132,
     0.076832,0.077529,0.078222,0.078913,0.079600,0.080285,0.080966,0.081645,0.082321,0.082995,
     0.083665,0.084333,0.084998,0.085661,0.086321,0.086979,0.087634,0.088287,0.088937,0.089585,
     0.090231,0.090874,0.091515,0.092154,0.092791,0.093425,0.094058,0.094688,0.095316,0.095943,
     0.096567,0.097189,0.097809,0.098427,0.099044,0.099658,0.100270,0.100881,0.101490,0.102097,
     0.102702,0.103306,0.103907,0.104507,0.105106,0.105702,0.106297,0.106891,0.107482,0.108072,
     0.108661,0.109248,0.109833,0.110417,0.110999,0.111580,0.112159,0.112737,0.113313,0.113888,
     0.114462,0.115034,0.115604,0.116173,0.116741,0.117308,0.117873,0.118437,0.118999,0.119560,
     0.120120,0.120679,0.121236,0.121792,0.122347,0.122900,0.123453,0.124004,0.124554,0.125102,
     0.125650,0.126196,0.126741,0.127285,0.127828,0.128370,0.128911,0.129450,0.129989,0.130526,
     0.131062,0.131597,0.132131,0.132664,0.133196,0.133727,0.134257,0.134786,0.135314,0.135840,
     0.136366,0.136891,0.137415,0.137938,0.138459,0.138980,0.139500,0.140019,0.140537,0.141055,
     0.141571,0.142086,0.142600,0.143114,0.143626,0.144138,0.144649,0.145159,0.145668,0.146176,
     0.146683,0.147189,0.147695,0.148200,0.148703,0.149206,0.149709,0.150210,0.150711,0.151210,
     0.151709,0.152207,0.152705,0.153201,0.153697,0.154192,0.154686,0.155180,0.155673,0.156164,
     0.156656,0.157146,0.157636,0.158125,0.158613,0.159100,0.159587,0.160073,0.160558,0.161043,
     0.161527,0.162010,0.162493,0.162974,0.163455,0.163936,0.164416,0.164895,0.165373,0.165851,
     0.166328,0.166804,0.167000
noutput=233                    !TO ks の dtexpout_Myr=5 の代わり: 開始 (z=127) から 5 Myr ごとの aout を並べ、最後は aend
foutput=1000000
walltime_hrs=23.5              !TO ks の maxruntime=23.5
restart_hrs=1.0
!KS fout_xa=-1
!KS fout_cb=-1
!KS fout_sp=-1
!KS fout_hl=-1
!KS fout_rhmx=-1
!KS fout_phmn=-1
ugvtk=.true.                   ! ugvtk 出力の主スイッチ (takashi で追加; ks では常に on)。fout_* 系は未移植
idp_ugvtk=-1
NI_ugvtk=64
p3_output_minmass=1d4
SFC_output_minmass=1d5
SFC_output_at_given_age=.true.  ! C_eps1: SFC / 印の周りの入れ子を 0.1/1/3/5/10 Myr で出力
/
&INIT_PARAMS
filetype='grafic'
initfile(1)='ICS/level_008'
initfile(2)='ICS/level_009'
initfile(3)='ICS/level_010'
initfile(4)='ICS/level_011'
initfile(5)='ICS/level_012'
initfile(6)='ICS/level_013'
omega_b=0.0494                 ! MUSIC 初期条件用 (ngridmax_fire3.nml は ks の omega_b0 既定 0.0493)
/
&AMR_PARAMS
levelmin=8
levelmax=24
nexpand=50*1
ngridmax=3150000               ! ランクあたり (flat の 7 倍)
npartmax=32000000              ! ランクあたり。境界粒子 (level 8 だけで 1.67e7) が 1 ランクに集まっても入る大きさ
/
&REFINE_PARAMS
m_refine=23*8
jeans_refine=23*8
mass_cut_refine=3.63798d-12    ! MUSIC の出力値 2/N^3
interpol_var=1
interpol_type=0
ivar_refine=11                 ! zoom-in scalar (NVAR=12: 6 metal, 7-10 ions, 11 zoom, 12 ks cooling flag)
var_cut_refine=0.3
jeans_refine_nH=1.0            ! Jeans 細分化は nH > 1 /cc だけ (移植 2026-11-27; zoom 領域の外は細分化しない)
strict_Npart_refine=.true.     ! m_refine は baryon 粒子を個数で数える (移植 2026-11-27)
Mmin_strict_Npart_refine=1d-30
!KS f_mass_sph=1d0
/
&HYDRO_PARAMS
gamma=1.666667
courant_factor=0.8
slope_type=1
scheme='muscl'
riemann='hllc'
pressure_fix=.true.
beta_fix=5.0
pressure_fix_cond=3            ! mode 1 + thermal-fraction gate (移植 2026-11-27)
pressure_fix_eta=0.05
/
&COOLING_PARAMS
cooling=.true.
neq_chem=.true.
metal=.true.
haardt_madau=.false.           ! UV background なし (ks と同じ)
z_reion=40
self_shielding=.true.
H2coolfunc='Glover'            ! ks の既定 (方針 2 で移植済み)
H2_fesc=.true.                 ! ks では常時オン
H2_Hm_cool=.true.              ! ks の no_H2Hm_cool=.false.
H2_chem_cool=.false.           ! job script で .false. に上書きされている
!KS met_switch=.false.
fclump_H2dust=1d0              ! isH2Katz の dust 生成率の clumping (ks と同じ 1)
/
&SF_PARAMS
sf_fg=.true.                   ! patch/ks の星形成 (star_formation_fg): Pop II (SFC) / Pop III、family は ks と同じ番号
eps_star=1d0                   ! C_eps1: tstar = t_ff
g_star=1.3333333
T2_star=0.0d0
n_star=-1                      ! sf_fg では pop2_njeans>0 のとき未使用 (ks と同じ -1)
m_star=1d2                     ! sf_fg では Pop II 粒子の質量 [Msun] (ks と同じ)
pop2_peak_only=.false.         ! C_eps1
pop2_njeans=4d0
Tpop2=1d4
pop2_model=2                   ! C_eps1: 局所モデル (Jeans 不安定 lambda_J < pop2_njeans dx、T < Tpop2、div v < 0)
pop2_SFC_marker=.true.         ! C_eps1: SFC 形成条件を満たした所に質量 0 の印
pop3_model=6
!KS BH_model=2                 ! sink (bhpop3) の段階
Zpop3=1d-5
dpop3=-1
mpop3max=100
mpop3_SNprog=-1d0
pop3_dist_min_pc=0.1
!KS pop2_SN_model='fixed'      ! フィードバックの段階
!KS pop2_no_delay_stochastic_SN=.false.
nonlocal_depletion=.true.
!KS flg_thin_star_cell=.false. ! RT/cooling の段階
!KS tage_thin_star_cell=-1d1
pop2_H2depSF=.false.
!KS pop2_sESN=1d50             ! フィードバックの段階
!KS pop2_SN_prob=-1d0
SFC_dist_min_pc=1d2
SFC_nH_min=1d2
SFC_f_nH_min=1d-2
SFC_fate='crop'
SFC_f_star=-1d0
SFC_f_star_Zdep=2
SFC_f_rhocrop=2d0
SFC_f_rhoSF=3d-2
SFC_distribution='mass_weight'
SFC_rsize_min_pc=1d0
SFC_flg_thin=.false.           ! 値は読むが cooling 側 (collect_active_SFC の遮蔽解除) は未移植
SFC_t_life=1d1
nH_postSF=-1d2
!KS nHmax_preSN=-1             ! フィードバックの段階
star_by_star=.false.
sbs_imf_name='Chabrier'
sbs_Mmin=1d0
!KS fJeans_cool=-1d0           ! cooling の段階
/
&FEEDBACK_PARAMS
eta_sn=0.1
yield=0.05
f_w=0
delayed_cooling=.false.
! fire3_yields=.true.         ! takashi の feedbk は常に FIRE-3 yields (msp0 方式)
! spread_feedback=.false.     ! 未移植 (ks 本番でも off)
! nonlocal_SN=.false.         ! 未移植 (ks 本番でも off)
pop3_ESN=3d52                  ! pop3_model 1/2 の Pop III SN エネルギー [erg]
SN_reservoir=.true.            ! SN 熱を冷却半径の球に体積比例で分配し refine 前に反映 (sn_energy_reservoir)
Ncell_SN_max=8.0d0
fcool_stop=8d0                 ! 冷却停止タイマー (NVAR の最後の passive scalar = ivar_coolstop; NPSCAL=3)
! sink_mass_min_pop3BH / sink_mass_min_pop2BH / smbh / bhpop3 は takashi では &SINK_PARAMS (下)
!KS halo_ref_level=13
!KS addrho_min=10
!KS nprof=100
!KS rfraction=0.01
!KS cind=5
!KS prt_cell=.false.
!KS flg_voffset_ini=.false.
!KS sgagn_seed='no'
!KS f_rho_add=-2d0
/
&SINK_PARAMS
create_sinks=.true.
accretion_scheme='bondi'
eddington_limit=.false.
nsinkmax=500
acc_sink_boost=1.0
ir_cloud=4
mass_sink_direct_force=3d2
smbh=.true.
bhpop3=.true.                  ! Pop III 残骸 (FAM_BH) からの BH sink (sink_particle_fg.f90)
BH_model=2                     ! SR20 降着 + RIAF/標準/slim の光度 (BHL にフォールバック)
sink_mass_min_pop3BH=1d1       ! [Msun]
sink_mass_min_pop2BH=-1d1      ! 負: Pop II 残骸 (FAM_DEAD) は sink にしない
no_sinkcloud_refine=.true.     ! sink の cloud 粒子は m_refine に数えない (takashi では &SINK_PARAMS)
/
&CLUMPFIND_PARAMS
ivar_clump=0
density_threshold=200
saddle_threshold=100
mass_threshold=10.
/
&RT_PARAMS
isHe=.true.
isH2=.true.
X=7.6d-1
Y=2.4d-1
rt_output_coolstats=.true.
rt_flux_scheme='glf'
rt_smooth=.true.
rt_courant_factor=0.8
rt_c_fraction=0.01            !TO ks は level ごと (VSLA、30*0.01); takashi はスカラー。値は同じ
rt_otsa=.true.
rt_is_init_xion=.false.        ! ks の既定: grafic 読み込みの既定値 (Peebles の残留電離 1.2e-5 sqrt(Om)/(h Ob)) を平衡電離度で上書きしない
rt_star=.true.
rt_esc_frac=1.0d0
sed_dir='SED'
sedprops_update=1
rt_nsubcycle=10
uv_file=''                     ! haardt_madau=.false. なので未使用 (ks は spec_LW ファイルを指すが同じく未使用)
cloudy_metal_cooling=.true.    ! 方針 1: takashi の cloudy テーブル (ks の cloudy_metal_HM12_z.bin ではない)
cloudy_metal_file='cloudy/cloudy_excess_metal_cooling.bin'
attn_after_chem=.true.
isH2Katz=.true.                ! ks の H2 化学 (H- 経路の生成、GA08 の衝突解離、15.2 eV、Baczynski の断面積; 移植済み)
relax_x_by_ne=.true.           ! ks の xHI 10% 則の MIN 形 (修正 F) に相当; こちらは H/He の全種に適用
! LW 群の自己遮蔽 (方針 3 で移植済み; ks の isH2Katz + LW_ss_wgh + LW_abs_thin + LW_abs_atom + LW_ss_from_incident_surface_yH2 に対応)
LWgroup=2                      ! LW 群 (11.2-13.6 eV)
LW_ss_model='WGH19'            ! ks の LW_ss_wgh=.true.
LW_ss_dust=.true.              ! ks では常時
LW_abs_thin=.true.
LW_abs_atom=.true.
LW_ss_from_incident_surface_yH2=.true.
!KS SS_LVG=.false.             ! 柱密度の長さは常にセル幅 (LVG は未移植)
!KS isFUVbin=.true.            ! FUV 5.6-11.2 eV の群 (ここでは群の定義で表現; 群 1)
iPEH_group=1                   ! 光電加熱 (ks の PEH=.true.); こちらは Bakes & Tielens の効率、吸収を放射場から除く、(1-xHII) で dust なし
PEH_all_FUV=.true.             ! G0 は group_egy が 5.4-13.6 eV に入る全群の和 (添字は決め打ちしない; この 5 群構成では群 1 と群 2)
!KS T_sputter=1d6              ! こちらは (1-xHII) の因子が代替
sec_ion=.false.                ! 2 次電離 (Ricotti+2002 のフィット; 移植済み、全群に適用)。ks 本番でもオフ
!KS isXray=.false.
!KS Xgroup=6
!KS p3_noFUV=.false.
!KS p3_noEUV=.false.
!KS p2_noFUV=.false.
!KS p2_noEUV=.false.
/
&RT_GROUPS
! 5 群をエネルギーの低い順に並べる (2026-11-27; ks は LW, HI, HeI, HeII, FUV の順):
! 1 FUV 5.6-11.2, 2 LW 11.2-13.6, 3 HI 13.6-24.59, 4 HeI 24.59-54.42, 5 HeII 54.42-200 eV
groupL0       = 5.60, 11.20, 13.60, 24.59, 54.42
groupL1       = 11.20, 13.60, 24.59, 54.42, 200.00
group_egy     = 8.4, 12.44, 18.85, 35.079, 65.666
spec2group    = 2,3,4,5              ! H2, HI, HeI, HeII の再結合光子が入る群
group_on      = 1, 1, 1, 1, 1
! 断面積は xd_rt.nml の同じ帯の値 (LW 群の H2 光解離 2.1e-19 を含む); sedprops_update=1 で SED から更新される
group_csn(1,:) = 0.0, 0.0, 0.0, 0.0
group_csn(2,:) = 2.1d-19, 0.0, 0.0, 0.0
group_csn(3,:) = 5.0d-18, 3.007d-18, 0.0, 0.0
group_csn(4,:) = 2.9d-18, 5.687d-19, 4.478d-18, 0.0
group_csn(5,:) = 4.1d-19, 7.889d-20, 1.197d-18, 1.055d-18
group_cse(1,:) = 0.0, 0.0, 0.0, 0.0
group_cse(2,:) = 2.1d-19, 0.0, 0.0, 0.0
group_cse(3,:) = 5.3d-18, 2.781d-18, 0.0, 0.0
group_cse(4,:) = 2.8d-18, 5.042d-19, 4.130d-18, 0.0
group_cse(5,:) = 4.1d-19, 7.456d-20, 1.142d-18, 1.001d-18
/

